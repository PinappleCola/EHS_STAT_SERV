{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.pineapplecola.darts",
  "Name": "DARTS Live Map",
  "Version": "0.1.0.0",
  "Author": "PineappleCola",
  "Description": "Coloured live-state MAP / IFR / VFR toggle keys for the DARTS live map.",
  "Icon": "imgs/plugin",
  "Category": "DARTS",
  "CategoryIcon": "imgs/category",
  "CodePath": "bin/darts-plugin",
  "CodePathWin": "bin/darts-plugin.exe",
  "CodePathMac": "bin/darts-plugin",
  "PropertyInspectorPath": "ui/settings.html",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Actions": [
    {
      "UUID": "com.pineapplecola.darts.map",
      "Name": "MAP toggle",
      "Tooltip": "Toggle the live map basemap (MAP TOGGLE). Green = on, red = off.",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.pineapplecola.darts.ifr",
      "Name": "IFR waypoints",
      "Tooltip": "Toggle IFR waypoints on the live map. Green = visible, red = hidden.",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "UUID": "com.pineapplecola.darts.vfr",
      "Name": "VFR waypoints",
      "Tooltip": "Toggle VFR waypoints on the live map. Green = visible, red = hidden.",
      "Icon": "imgs/action",
      "Controllers": [
        "Keypad"
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}